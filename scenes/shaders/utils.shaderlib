
// Standard forward perspective depth: WebGPU [0,1], near/far in world units.
// Returns positive view-space distance. Orthographic/reversed-Z need a
// different conversion; no camera uniforms are assumed by this helper.
fn linear_depth(depth: f32, near: f32, far: f32) -> f32 {
	return near * far / max(far - depth * (far-near), 1e-6);
}

fn linear_to_srgb(color: vec3f) -> vec3f {
	let positive = max(color, vec3f(0.0));
	return select(1.055*pow(positive, vec3f(1.0/2.4))-0.055,
		positive*12.92, positive <= vec3f(0.0031308));
}

fn srgb_to_linear(color: vec3f) -> vec3f {
	return select(pow((color+0.055)/1.055, vec3f(2.4)), color/12.92, color <= vec3f(0.04045));
}

// Isotropic mip footprint from screen-space UV derivatives, in base texels.
fn texture_lod_from_gradients(dx: vec2f, dy: vec2f, dimensions: vec2f) -> f32 {
	let x = dx*dimensions;
	let y = dy*dimensions;
	return max(0.0, 0.5*log2(max(max(dot(x, x), dot(y, y)), 1e-8)));
}

fn hash_u32(value: u32) -> u32 {
	var x = value;
	x = (x ^ (x >> 16u)) * 0x7feb352du;
	x = (x ^ (x >> 15u)) * 0x846ca68bu;
	return x ^ (x >> 16u);
}

fn unpack_rotation(packed: vec2u) -> vec4f {
	return vec4f( unpack2x16snorm(packed.x), unpack2x16snorm(packed.y) );
}

fn unpack_scale(packed: vec2u) -> vec3f {
	return vec3f( unpack2x16float(packed.x).xy, unpack2x16float(packed.y).x );
}

fn quat_rotate(q: vec4f, v: vec3f) -> vec3f {
	let t = cross(q.xyz, v) * 2.0;
	return v + q.w * t + cross(q.xyz, t);
}

fn world_position(
	position: vec3f,
	iPosition: vec3f,
	iRotation: vec4f,
	iScale: vec3f,
) -> vec3f {
	return iPosition + quat_rotate(iRotation, position * iScale);
}

#macro instance_transform_unpacking(InstanceType)

struct InstanceTransform {
	rotation:  vec4f,
	scale:     vec3f,
	world_pos: vec3f,
};

fn unpack_instance_transform(vertex_position: vec3f, inst: {{ InstanceType }}) -> InstanceTransform {
	let rotation = unpack_rotation(inst.iRotation);
	let scale = unpack_scale(inst.iScale);
	let position = world_position(vertex_position, inst.iPosition, rotation, scale);
	return InstanceTransform(rotation, scale, position);
}
#endmacro

#macro unpack_srgb_color()
fn srgb_to_linear_channel(c: f32) -> f32 {
	if c <= 0.04045 {
		return c / 12.92;
	}
	return pow((c + 0.055) / 1.055, 2.4);
}

fn unpack_rgba8_srgb(c: u32) -> vec4f {
	let rgba = vec4f(
		f32(c & 255u),
		f32((c >> 8u) & 255u),
		f32((c >> 16u) & 255u),
		f32((c >> 24u) & 255u),
	) / 255.0;

	return vec4f(
		srgb_to_linear_channel(rgba.r),
		srgb_to_linear_channel(rgba.g),
		srgb_to_linear_channel(rgba.b),
		rgba.a,
	);
}
#endmacro
