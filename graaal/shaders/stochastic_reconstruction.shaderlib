#include "utils_depth.shaderlib"

#include "frame.shaderlib"
sample_texture<1, 1> main_color: f32;
#if PARAMS.get("keyed_tail", false)
texture<1, 2> transmittance: texture_2d<f32>;
fn tail_t(pixel: vec2i, sample: u32) -> vec4f { return textureLoad(transmittance, pixel, 0); }
#else
sample_texture<1, 2> transmittance: f32;
fn tail_t(pixel: vec2i, sample: u32) -> vec4f { return sample_texture_load(transmittance, pixel, sample); }
#endif
sample_texture<1, 3, layered> winner_color: f32;
sample_texture<1, 4> opaque_depth: depth;
<BilateralSettings> sigmas: vec4f;
<BilateralSettings> kernel: vec4u;
uniform<1, 5> bilateral: BilateralSettings;
#if PARAMS.get("filter_input", false)
sample_texture<1, 12, layered> filter_input: f32;
#endif
sample_texture<1, 6> transparent_depth: depth;
sample_texture<1, 7> transparent_guide: f32;

#if PARAMS.get("force_single_contributor", false)
sample_texture<1, 9> contributor_count: f32;
#endif

#if PARAMS.get("winner_count", 1) == 2 and PARAMS.get("winner_mix", "average") == "average"
sample_texture<1, 8, layered> first_color: f32;
#endif

#if PARAMS.get("winner_mix", "average") == "fill"
sample_texture<1, 10, layered> winner_source: u32;
#endif

fn winner_at(pixel: vec2i, sample: u32) -> vec4f {
#if PARAMS.get("banded_mixed", false)
	return sample_texture_load(winner_color, pixel, 0u, layered=true);
#else
	return sample_texture_load(winner_color, pixel, sample, layered=true);
#endif
}

#if RECONSTRUCT_MODE is not defined or RECONSTRUCT_MODE != "profile"
fn filter_input_at(pixel: vec2i, sample: u32) -> vec4f {
#if PARAMS.get("filter_input", false)
	var value = sample_texture_load(filter_input, pixel, sample, layered=true);
#if PARAMS.get("exact_nearest", false) and PARAMS.get("initial_pairs", false)
	value.a = max(1.0-tail_t(pixel, sample).a, 0.0);
#endif
	return value;
#else
#if PARAMS.get("exact_nearest", false)
	return vec4f(winner_at(pixel, sample).rgb, max(1.0-tail_t(pixel, sample).a, 0.0));
#else
	return winner_at(pixel, sample);
#endif
#endif
}

#endif

fn forced_at(pixel: vec2i, sample: u32) -> bool {
#if PARAMS.get("force_single_contributor", false)
	return tail_t(pixel, sample).a < 1.0 &&
		sample_texture_load(contributor_count, pixel, sample).r == 1.0 && winner_at(pixel, sample).a > 0.0;
#else
	return false;
#endif
}

#if RECONSTRUCT_MODE is not defined or RECONSTRUCT_MODE == "compose"
fn debug_color(winner: vec4f) -> vec3f {
#if PARAMS.get("force_single_contributor", false) or PARAMS.get("winner_mix", "average") == "fill" or PARAMS.get("keyed_tail", false)
	return max(winner.rgb/max(winner.a, 1e-6), vec3f(0.0));
#else
	return max(winner.rgb, vec3f(0.0));
#endif
}
#endif

#if RECONSTRUCT_MODE is not defined or RECONSTRUCT_MODE != "profile"
// Weighted winner samples remain unnormalized until the neighborhood reduction.
<FilterData> transmission: vec4f;
<FilterData> winner: vec4f;
<FilterData> guide: vec4f;
<FilterData> depths: vec2f;

#if PARAMS.get("tiled_reconstruction", false)
// 8x8 output with a radius-four halo: 256 cached samples, 14 KiB total.
var<workgroup> cached_transmission: array<vec4f, 256>;
var<workgroup> cached_winner: array<vec4f, 256>;
var<workgroup> cached_guide: array<vec4f, 256>;
var<workgroup> cached_depths: array<vec2f, 256>;
#endif

fn load_filter_data(pixel: vec2i, sample: u32) -> FilterData {
	let opaque = sample_texture_load(opaque_depth, pixel, sample);
	let transparent = sample_texture_load(transparent_depth, pixel, sample);
	return FilterData(tail_t(pixel, sample), filter_input_at(pixel, sample),
		sample_texture_load(transparent_guide, pixel, sample),
		vec2f(linear_depth(min(opaque, transparent), frame.clip.x, frame.clip.y),
			linear_depth(opaque, frame.clip.x, frame.clip.y)));
}

fn filter_data_at(pixel: vec2i, sample: u32, origin: vec2i, side: u32) -> FilterData {
#if PARAMS.get("tiled_reconstruction", false)
	let offset = vec2u(pixel-origin);
	let index = offset.y*side+offset.x;
	return FilterData(cached_transmission[index], cached_winner[index], cached_guide[index], cached_depths[index]);
#else
	return load_filter_data(pixel, sample);
#endif
}

fn bilateral_weight(center: FilterData, neighbor: FilterData, offset: vec2i) -> f32 {
	let sigmas = bilateral.sigmas;
	let dt = neighbor.transmission-center.transmission;
	let spatial = f32(offset.x*offset.x+offset.y*offset.y)/(2.0*sigmas.x*sigmas.x);
	let depth = center.depths.x;
	let depth_q = neighbor.depths.x;
	var difference = abs(depth_q-depth);
	if center.guide.w > 0.0 && neighbor.guide.w > 0.0 {
		let predicted_q = 1.0/max(1.0/depth+dot(center.guide.yz, vec2f(offset)), 1e-6);
		let predicted_p = 1.0/max(1.0/depth_q-dot(neighbor.guide.yz, vec2f(offset)), 1e-6);
		difference = max(abs(depth_q-predicted_q), abs(depth-predicted_p));
	}
	let depth_delta = difference/max(depth*sigmas.y, sigmas.w);
	let opaque_delta = (neighbor.depths.y-center.depths.y)/max(center.depths.y*sigmas.y, sigmas.w);
	let transmission_delta = dot(dt, dt)/(2.0*sigmas.z*sigmas.z);
	return exp(-spatial - 0.5*(depth_delta*depth_delta+opaque_delta*opaque_delta) - transmission_delta);
}

#if RECONSTRUCT_MODE is not defined or RECONSTRUCT_MODE in ("compose", "color")
fn point_reconstruction(pixel: vec2i, sample: u32) -> vec4f {
	let t = tail_t(pixel, sample);
	let acceptance = 1.0-t.a;
	if acceptance <= 1e-6 { return vec4f(0.0); }
	return vec4f((vec3f(1.0)-t.rgb)*winner_at(pixel, sample).rgb/max(acceptance, 1e-6), 1.0);
}
#endif

fn needs_reconstruction(pixel: vec2i, sample: u32) -> bool {
	if 1.0-tail_t(pixel, sample).a <= 1e-6 { return false; }
	if bilateral.kernel.y == 4u { return true; }
	return sample_texture_load(transparent_guide, pixel, sample).x != 1.0 && !forced_at(pixel, sample);
}

#if not PARAMS.get("compute_reconstruction", false) or PARAMS.get("tiled_reconstruction", false)
<FilterReduction> pair: vec4f;
<FilterReduction> weight_sum: f32;
<FilterReduction> squared_sum: f32;

fn reduce_neighborhood(pixel: vec2i, sample: u32, origin: vec2i, side: u32) -> FilterReduction {
	let dimensions = vec2i(textureDimensions(transmittance));
	let center = filter_data_at(pixel, sample, origin, side);
	var pair = vec4f(0.0);
	var weight_sum = 0.0;
	var squared_sum = 0.0;
	let radius = i32(bilateral.kernel.x);
	for (var y = -radius; y <= radius; y += 1) {
		for (var x = -radius; x <= radius; x += 1) {
			let q = pixel+vec2i(x, y);
			if any(q < vec2i(0)) || any(q >= dimensions) { continue; }
			let neighbor = filter_data_at(q, sample, origin, side);
			let weight = bilateral_weight(center, neighbor, vec2i(x, y));
			pair += weight*neighbor.winner;
			weight_sum += weight;
			squared_sum += weight*weight;
		}
	}
	return FilterReduction(pair, weight_sum, squared_sum);
}

#if RECONSTRUCT_MODE is not defined or RECONSTRUCT_MODE == "pair"
fn reconstruct_pair(pixel: vec2i, sample: u32, origin: vec2i, side: u32) -> vec4f {
	if 1.0-tail_t(pixel, sample).a <= 1e-6 { return vec4f(0.0); }
	if !needs_reconstruction(pixel, sample) { return winner_at(pixel, sample); }
	let reduced = reduce_neighborhood(pixel, sample, origin, side);
	// Average the unnormalized pair. Apply opacity and normalize only at the end.
	return reduced.pair/max(reduced.weight_sum, 1e-6);
}
#endif

#if RECONSTRUCT_MODE is not defined or RECONSTRUCT_MODE in ("compose", "color")
fn reconstruct_transparency(pixel: vec2i, sample: u32, origin: vec2i, side: u32) -> vec4f {
	let t = tail_t(pixel, sample);
	if 1.0-t.a <= 1e-6 { return vec4f(0.0); }
	if bilateral.kernel.x == 0u { return point_reconstruction(pixel, sample); }
	if !needs_reconstruction(pixel, sample) {
		let own = winner_at(pixel, sample);
		return vec4f((vec3f(1.0)-t.rgb)*own.rgb/max(own.a, 1e-6), 0.0);
	}
	let reduced = reduce_neighborhood(pixel, sample, origin, side);
	let width = f32(2u*bilateral.kernel.x+1u);
	return vec4f((vec3f(1.0)-t.rgb)*reduced.pair.rgb/max(reduced.pair.a, 1e-6),
		reduced.weight_sum*reduced.weight_sum/max(reduced.squared_sum, 1e-6)/(width*width));
}
#endif
#endif

#endif
