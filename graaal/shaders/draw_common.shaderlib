// Shared storage ABI: 32 bytes per instance, matching DrawBatches.instance_dtype.
<MeshInstance> iPosition: vec3f;
<MeshInstance> iTint: u32;
<MeshInstance> iRotation: vec2u;
<MeshInstance> iScale: vec2u;

#macro instance_bindings()
// Group 0: shared frame uniforms. Extra material/instance data uses group 2+.
<Uniforms> view: mat4x4f;
<Uniforms> proj: mat4x4f;
<Uniforms> light_dir: vec4f;

uniform<0, 0> uniforms: Uniforms;

// Group 1: instance data and the visibility list for the selected pass.
storage<1, 0, read> instances: array<MeshInstance>;
storage<1, 1, read> visible_instances: array<u32>;
#endmacro
