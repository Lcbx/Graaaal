// Shared view/frame ABI for material raster, deferred shading, and composition.
<Frame> view: mat4x4f;
<Frame> proj: mat4x4f;
<Frame> camera_position: vec4f;
// clip: near, far, surface noise-cell width in pixels, noise mode.
<Frame> clip: vec4f;
// Legacy direct-material fade: start degrees, end degrees, enabled, reserved.
<Frame> grazing: vec4f;
<Frame> time: f32;
// UV footprint compromise: 0=max derivative, .5=area, 1=min derivative.
<Frame> noise_footprint_balance: f32;
// Anchored blue: coarse target in pixels, fine shift subdivisions, reserved.
<Frame> noise_anchor: vec4f;
uniform<0, 0> frame: Frame;

// Scene lighting changes independently of camera motion and frame time.
<Lighting> light_dir: vec4f;
uniform<0, 1> lighting: Lighting;
