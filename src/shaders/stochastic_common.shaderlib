<Frame> view: mat4x4f;
<Frame> proj: mat4x4f;
<Frame> light_dir: vec4f;
<Frame> camera_position: vec4f;
// clip: near, far, unused, unused.
<Frame> clip: vec4f;
@group(0) @binding(0) var<uniform> frame: Frame;

<Material> base_color: vec4f;
<Material> emission: vec4f;
<Material> surface: vec4f;
<Material> opacity_rgb: vec4f;
<Material> flags: vec4u;
@group(2) @binding(0) var<storage, read> metadata: array<vec4u>;
@group(2) @binding(1) var<storage, read> materials: array<Material>;
@group(2) @binding(2) var base_textures: texture_2d_array<f32>;
@group(2) @binding(3) var material_sampler: sampler;

fn base_color(material: Material, uv: vec2f, lod: f32) -> vec4f {
	return material.base_color * textureSampleLevel(base_textures, material_sampler, uv, i32(material.flags.x), lod);
}

fn opacity(material: Material, uv: vec2f, lod: f32) -> vec3f {
	return clamp(base_color(material, uv, lod).a * material.opacity_rgb.rgb, vec3f(0.0), vec3f(1.0));
}

fn shade(material: Material, uv: vec2f, position: vec3f, normal: vec3f, lod: f32) -> vec3f {
	let color = base_color(material, uv, lod).rgb;
	let n = normal / max(length(normal), 1e-6);
	let l = normalize(frame.light_dir.xyz);
	let v = normalize(frame.camera_position.xyz - position);
	let h = normalize(l + v);
	let diffuse = 0.25 + 0.75 * max(dot(n, l), 0.0);
	let exponent = mix(128.0, 4.0, clamp(material.surface.x, 0.0, 1.0));
	let specular = pow(max(dot(n, h), 0.0), exponent) * max(dot(n, l), 0.0);
	return color * diffuse * (1.0 - 0.6 * material.surface.y)
		+ mix(vec3f(0.04), color, material.surface.y) * specular + material.emission.rgb;
}
