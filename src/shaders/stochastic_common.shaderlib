#include "frame.shaderlib"

// The face half stores +/-1; its low mantissa bit is available for flags.
const WINNER_FORCED_BIT: u32 = 0x00010000u;

<Material> base_color: vec4f;
<Material> emission: vec4f;
<Material> surface: vec4f;
<Material> opacity_rgb: vec4f;
<Material> flags: vec4u;
<MaterialVertex> position: vec3f;
<MaterialVertex> normal: vec3f;
<MaterialVertex> uv: vec2f;
@group(2) @binding(0) var<storage, read> metadata: array<vec4u>;
@group(2) @binding(1) var<storage, read> materials: array<Material>;
@group(2) @binding(2) var base_textures: texture_2d_array<f32>;
@group(2) @binding(3) var material_sampler: sampler;

fn base_color(material: Material, uv: vec2f, lod: f32) -> vec4f {
	return material.base_color * textureSampleLevel(base_textures, material_sampler, uv, i32(material.flags.x), lod);
}

fn opacity(material: Material, uv: vec2f, lod: f32) -> vec3f {
	return clamp(base_color(material, uv, lod).a * material.opacity_rgb.rgb, vec3f(0.0), vec3f(1.0));
}

#include "material_lighting.shaderlib"

#if PARAMS.get("material_library") is not none
{{ PARAMS.material_library }}
#elif PARAMS.get("material_source") is not none
{{ PARAMS.material_source }}
#else
#include "stochastic_material.shaderlib"
#endif

fn deform_vertex(id: u32, position: vec3f, normal: vec3f, uv: vec2f) -> MaterialVertex {
#if PARAMS.get("material_library") is not none
	return library_vertex(id, position, normal, uv);
#else
	return MaterialVertex(position, normal, uv);
#endif
}

fn get_material(id: u32) -> Material {
#if PARAMS.get("material_library") is not none
	return library_material(id);
#else
	return materials[metadata[id].y];
#endif
}

fn shade_material(id: u32, material: Material, uv: vec2f, position: vec3f, normal: vec3f, lod: f32) -> vec3f {
#if PARAMS.get("material_library") is not none
	return library_shade(id, material, uv, position, normal, lod);
#else
	return shade(material, uv, position, normal, lod);
#endif
}
